      <aliases enabled='yes' />
      <column datatype='integer' name='[Ano]' role='dimension' type='quantitative' />
      <column caption='Chave Loja Dia' datatype='string' name='[Calculation_0887581797433345]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([ID_Loja]) + &quot;-&quot; + STR([ID_Calendario])' />
      </column>
      <column caption='Produto Label' datatype='string' name='[Calculation_0887581797556226]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([ID_Produto]) + &quot; - &quot; + [Marca] + &quot; &quot; + [Descricao] + &quot; &quot; + [Tamanho]' />
      </column>
      <column caption='Loja Dia Com Produto Base' datatype='integer' name='[Calculation_0887581797969923]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [ID_Loja], [ID_Calendario] :&#13;&#10;    MAX(&#13;&#10;        IF [Calculation_0887581797556226] = [Parameters].[Parameter 4]&#13;&#10;        THEN 1&#13;&#10;        ELSE 0&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Nao E Produto Base' datatype='boolean' name='[Calculation_0887581798322180]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_0887581797556226] &lt;&gt; [Parameters].[Parameter 4]' />
