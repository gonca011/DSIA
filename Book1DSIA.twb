      <column caption='Classificação do Quadrante' datatype='string' name='[Calculation_0887581816459273]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0887581814325254] &gt;= WINDOW_MEDIAN([Calculation_0887581814325254])&#13;&#10;AND [Calculation_0887581814501383] &lt;= WINDOW_MEDIAN([Calculation_0887581814501383])&#13;&#10;THEN &quot;Alta procura / Baixo volume&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_0887581814325254] &gt;= WINDOW_MEDIAN([Calculation_0887581814325254])&#13;&#10;AND [Calculation_0887581814501383] &gt; WINDOW_MEDIAN([Calculation_0887581814501383])&#13;&#10;THEN &quot;Alta procura / Alto volume&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_0887581814325254] &lt; WINDOW_MEDIAN([Calculation_0887581814325254])&#13;&#10;AND [Calculation_0887581814501383] &lt;= WINDOW_MEDIAN([Calculation_0887581814501383])&#13;&#10;THEN &quot;Baixa procura / Baixo volume&quot;&#13;&#10;&#13;&#10;ELSE &quot;Baixa procura / Alto volume&quot;&#13;&#10;END'>
