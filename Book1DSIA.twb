              <semantic-values semantic-role='[Geographical].[Longitude]'>
                <semantic-value key='&quot;AETHELNEY&quot;' value='-2.9321999999999999' />
                <semantic-value key='&quot;ALNERWICK&quot;' value='-1.70563' />
