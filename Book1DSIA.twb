      <column caption='Procura / Frequência de Venda' datatype='real' name='[Calculation_0887581814325254]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#13;&#10;    { FIXED [ID_Produto] : COUNTD([Calculation_0887581797433345]) }&#13;&#10;)&#13;&#10;/&#13;&#10;AVG(&#13;&#10;    { FIXED [ID_Produto] : COUNTD([N_Loja]) }&#13;&#10;)' />
