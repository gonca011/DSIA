    <worksheet name='IG15 e IG12'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='8'>IG15: Analisar Produtos que Vendem Mais por Época do Ano por Loja por Cidade e IG12: Analisar Produtos com Alto Volume de Vendas por Loja por Cidade</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dsia_short' name='federated.1wfimeo0jbqzyo1csguat1jfh2tt' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Top Produtos' datatype='integer' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wfimeo0jbqzyo1csguat1jfh2tt'>
            <column caption='Produto Label' datatype='string' name='[Calculation_0887581797556226]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([ID_Produto]) + &quot; - &quot; + [Marca] + &quot; &quot; + [Descricao] + &quot; &quot; + [Tamanho]' />
            </column>
            <column caption='Registos Válidos' datatype='boolean' name='[Calculation_1175928923602945]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT ISNULL([Cidade]) AND NOT ISNULL([N_Loja])' />
            </column>
            <column caption='Rank Produto por Loja Época' datatype='integer' name='[Calculation_1416996228980744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_DENSE(SUM([Quantidade_Vendida]), &apos;desc&apos;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Mostrar Top N Produtos' datatype='boolean' name='[Calculation_1416996229128201]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1416996228980744] &lt;= [Parameters].[Parameter 1]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Época do Ano' datatype='string' name='[Calculation_1416996244021261]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEPART(&apos;month&apos;, [Data]) = 12&#13;&#10;OR DATEPART(&apos;month&apos;, [Data]) = 1&#13;&#10;OR DATEPART(&apos;month&apos;, [Data]) = 2 THEN&#13;&#10;    &quot;Inverno&quot;&#13;&#10;&#13;&#10;ELSEIF DATEPART(&apos;month&apos;, [Data]) &gt;= 3&#13;&#10;AND DATEPART(&apos;month&apos;, [Data]) &lt;= 5 THEN&#13;&#10;    &quot;Primavera&quot;&#13;&#10;&#13;&#10;ELSEIF DATEPART(&apos;month&apos;, [Data]) &gt;= 6&#13;&#10;AND DATEPART(&apos;month&apos;, [Data]) &lt;= 8 THEN&#13;&#10;    &quot;Verão&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;    &quot;Outono&quot;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Cidade]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
              <semantic-values semantic-role='[Geographical].[Latitude]'>
