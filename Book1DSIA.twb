  <worksheets>
    <worksheet name='IG13'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='10'>IG13: Analisar Produtos com Muita Procura e Produtos com Baixo Volume de Vendas por Loja</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dsia_short' name='federated.1wfimeo0jbqzyo1csguat1jfh2tt' />
          </datasources>
          <datasource-dependencies datasource='federated.1wfimeo0jbqzyo1csguat1jfh2tt'>
            <column caption='Chave Loja Dia' datatype='string' name='[Calculation_0887581797433345]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([ID_Loja]) + &quot;-&quot; + STR([ID_Calendario])' />
            </column>
            <column caption='Produto Label' datatype='string' name='[Calculation_0887581797556226]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([ID_Produto]) + &quot; - &quot; + [Marca] + &quot; &quot; + [Descricao] + &quot; &quot; + [Tamanho]' />
            </column>
            <column caption='Procura / Frequência de Venda' datatype='real' name='[Calculation_0887581814325254]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(&#13;&#10;    { FIXED [ID_Produto] : COUNTD([Calculation_0887581797433345]) }&#13;&#10;)&#13;&#10;/&#13;&#10;AVG(&#13;&#10;    { FIXED [ID_Produto] : COUNTD([N_Loja]) }&#13;&#10;)' />
            </column>
            <column caption='Quantidade Média por Loja' datatype='real' name='[Calculation_0887581814501383]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Quantidade_Vendida]) / COUNTD([ID_Loja])' />
            </column>
            <column caption='Classificação do Quadrante' datatype='string' name='[Calculation_0887581816459273]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0887581814325254] &gt;= WINDOW_MEDIAN([Calculation_0887581814325254])&#13;&#10;AND [Calculation_0887581814501383] &lt;= WINDOW_MEDIAN([Calculation_0887581814501383])&#13;&#10;THEN &quot;Alta procura / Baixo volume&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_0887581814325254] &gt;= WINDOW_MEDIAN([Calculation_0887581814325254])&#13;&#10;AND [Calculation_0887581814501383] &gt; WINDOW_MEDIAN([Calculation_0887581814501383])&#13;&#10;THEN &quot;Alta procura / Alto volume&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_0887581814325254] &lt; WINDOW_MEDIAN([Calculation_0887581814325254])&#13;&#10;AND [Calculation_0887581814501383] &lt;= WINDOW_MEDIAN([Calculation_0887581814501383])&#13;&#10;THEN &quot;Baixa procura / Baixo volume&quot;&#13;&#10;&#13;&#10;ELSE &quot;Baixa procura / Alto volume&quot;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Registos Válidos' datatype='boolean' name='[Calculation_1175928923602945]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT ISNULL([Cidade]) AND NOT ISNULL([N_Loja])' />
            </column>
            <column datatype='string' name='[Cidade]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
              <semantic-values semantic-role='[Geographical].[Latitude]'>
                <semantic-value key='&quot;AETHELNEY&quot;' value='51.056399999999996' />
                <semantic-value key='&quot;ALNERWICK&quot;' value='55.413179999999997' />
