            </column>
            <column datatype='string' name='[Descricao]' role='dimension' semantic-role='' type='nominal' />
            <column aggregation='Sum' caption='ID Calendario' datatype='integer' name='[ID_Calendario]' role='dimension' type='ordinal' />
            <column aggregation='Sum' caption='ID Loja' datatype='integer' name='[ID_Loja]' role='dimension' type='ordinal' />
